# Local dev values. For the hosted Render/Vercel deployment, these are set
# in each platform's dashboard instead — see docs/deployment.md.

# --- apps/api ---
DATABASE_URL=postgresql+asyncpg://observatory:observatory@localhost:5432/observatory
CORS_ORIGINS=http://localhost:3000
QWEN_API_BASE=http://127.0.0.1:30001/v1
QWEN_API_KEY=
QWEN_MODEL=qwen2.5-7b

# --- apps/web (put these in apps/web/.env.local) ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/stream
