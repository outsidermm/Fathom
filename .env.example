# Local dev values. Hosted values go in the single Vercel project's environment
# settings (Preview/Production as appropriate) — see docs/deployment.md.
# The API reads process environment variables; copying this file alone does
# not load them. Export API overrides in your shell before starting uvicorn.

# --- apps/api ---
# Optional local Postgres only; no code reads this yet. Hosted DB is deferred.
DATABASE_URL=postgresql+asyncpg://observatory:observatory@localhost:5432/observatory
# HTTP CORS only. /ws/stream currently accepts any origin and has no auth.
# Hosted: https://<project>.vercel.app (comma-separated, no spaces).
# Same-origin Services requests do not need cross-origin HTTP permissions.
CORS_ORIGINS=http://localhost:3000
# Hosted: James's publicly reachable HTTPS endpoint including /v1.
# Vercel cannot reach a laptop's localhost SSH tunnel.
QWEN_API_BASE=http://127.0.0.1:30001/v1
# Project secret; never put this in NEXT_PUBLIC_* variables or browser code.
QWEN_API_KEY=
QWEN_MODEL=qwen2.5-7b

# --- apps/web (put these in apps/web/.env.local) ---
# Hosted Services values (set explicitly in Vercel; do not leave unset):
# NEXT_PUBLIC_API_BASE=""
# NEXT_PUBLIC_WS_URL=/ws/stream
# API_BASE is an origin prefix, not /api. Empty means same-origin REST paths.
# The browser resolves /ws/stream to wss:// on HTTPS. Rebuild after changing.
# Keep the localhost values below for separate npm dev + uvicorn servers.
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/stream
