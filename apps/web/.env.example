# Separate local Next.js + Uvicorn servers:
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/stream

# Hosted Vercel Services (or vercel dev from the repo root):
# Set explicitly; unset variables fall back to localhost in contract.ts.
# NEXT_PUBLIC_API_BASE=""
# NEXT_PUBLIC_WS_URL=/ws/stream
# Empty API_BASE keeps /api/... requests on this origin; do not use /api here.
# The browser resolves the socket path on this origin, using wss on HTTPS.
